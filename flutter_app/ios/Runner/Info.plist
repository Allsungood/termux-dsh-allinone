[project]
name = "termux-dsh-allinone"
version = "1.0.0+1"
description = "A Flutter app that provides one-click access to dsh, openclaw, and ollama on Android with integrated Termux environment."

[schemes]
*
  [scheme.cameras]
  urlScheme = "termuxallinone"

[urls]
*
  [urls.cameras]
  schemes = ["termuxallinone"]

[privacy]
  [privacy.network]
  allowsArbitraryLoads = true

[permissions]
  INTERNET
  ACCESS_NETWORK_STATE
  ACCESS_WIFI_STATE
  FOREGROUND_SERVICE
  FOREGROUND_SERVICE_SPECIAL_USE
  POST_NOTIFICATIONS
  WAKE_LOCK
  BLUETOOTH
  BLUETOOTH_ADMIN
  CAMERA
  RECORD_AUDIO
  MODIFY_AUDIO_SETTINGS
  VIBRATE
  WRITE_EXTERNAL_STORAGE
  READ_EXTERNAL_STORAGE
  READ_PHONE_STATE
  READ_MEDIA_IMAGES
  READ_MEDIA_VIDEO
  READ_MEDIA_AUDIO

[info_plist]
  NSUserTrackingUsageDescription = "This app uses tracking to personalize your experience."
  NSLocationWhenInUseUsageDescription = "Location is used for nearby device discovery."